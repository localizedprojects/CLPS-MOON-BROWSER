{
  "name": "polar-horizon-charts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + Plotly chart views (sky plot, timeline, comparison) embedded in the Lunar Horizon Flutter app. Render-only: all science comes from the Dart core via the bridge.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "plotly.js-basic-dist-min": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.0"
  }
}
